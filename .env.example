# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

POSTGRES_USER=sbom_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sbom_db

# Default PostgreSQL port.
# Change this if port 5432 is already being used.
POSTGRES_PORT=5432

# Keep these values consistent with the PostgreSQL settings above.
DATABASE_URL=postgresql://sbom_user:change-me@127.0.0.1:5432/sbom_db

REDIS_URL=redis://localhost:6379/0
